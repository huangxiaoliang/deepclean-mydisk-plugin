{
  "name": "deepclean-mydisk",
  "version": "0.10.1",
  "private": true,
  "description": "DeepClean MyDisk —— DSH 插件：只读磁盘体检 + 空间可视化 + 相似照片 + 微信/企微专清 + 跨盘搬家 + 可撤销清理。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangxiaoliang/deepclean-mydisk-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/huangxiaoliang/deepclean-mydisk-plugin/issues"
  },
  "homepage": "https://github.com/huangxiaoliang/deepclean-mydisk-plugin#readme"
}
