{
  "name": "deepclean-mydisk",
  "version": "0.13.1",
  "description": "Read-only disk audit and cleanup for macOS and Windows: caches, leftovers, similar photos, space breakdown, and cross-disk file moves.",
  "author": "huangxiaoliang",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "disk",
    "storage",
    "cleanup",
    "macos",
    "windows"
  ],
  "icon": "./assets/icon-180.png",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml",
    "README.md",
    "SUPPORT.md",
    "SECURITY.md",
    "LICENSE",
    "locale/*.json",
    "docs/plugin",
    "assets/icon-180.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangxiaoliang/deepclean-mydisk-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/huangxiaoliang/deepclean-mydisk-plugin/issues"
  },
  "homepage": "https://github.com/huangxiaoliang/deepclean-mydisk-plugin#readme"
}
